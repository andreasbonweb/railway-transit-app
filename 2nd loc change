<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>RailGo - Live Railway Route Planning & Tracking</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    /* Mobile frame styling */
    body {
      background: radial-gradient(circle at top, #171225 0%, #050408 55%, #000000 100%);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .phone-container {
      background: linear-gradient(180deg, #12101b 0%, #111111 38%, #0d0b12 100%);
    }
    .screen {
      background: radial-gradient(circle at 50% -8%, rgba(89, 65, 130, 0.14), transparent 38%);
    }
    .purple-accent {
      color: #c4b5fd;
      background-color: rgba(109, 88, 145, 0.2);
      border-color: rgba(139, 115, 180, 0.45);
    }
    .phone-container {
      max-width: 420px;
      min-height: 100vh;
      margin: 0 auto;
      background: #111111;
      display: flex;
      flex-direction: column;
      position: relative;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
    }
    .pulse-dot {
      animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: .4; transform: scale(1.2); }
    }
    .train-track {
      position: relative;
    }
    .train-track::before {
      content: '';
      position: absolute;
      left: 19px;
      top: 15px;
      bottom: 15px;
      width: 4px;
      background: #555555;
      border-radius: 2px;
    }

    /* ── Location Card Styles ── */
    .location-card {
      position: relative;
      overflow: hidden;
    }
    .location-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(59, 130, 246, 0.06) 0%, transparent 60%);
      pointer-events: none;
    }
    .location-ping {
      animation: locationPing 2s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
    @keyframes locationPing {
      0% { transform: scale(1); opacity: 0.8; }
      75%, 100% { transform: scale(2.2); opacity: 0; }
    }
    .location-breathe {
      animation: breathe 3s ease-in-out infinite;
    }
    @keyframes breathe {
      0%, 100% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.25); }
      50% { box-shadow: 0 0 0 8px rgba(59, 130, 246, 0); }
    }
    .shimmer-btn {
      position: relative;
      overflow: hidden;
    }
    .shimmer-btn::after {
      content: '';
      position: absolute;
      top: 0; left: -100%; width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
      animation: shimmer 2.5s infinite;
    }
    @keyframes shimmer {
      0% { left: -100%; }
      100% { left: 100%; }
    }
    .fade-in-up {
      animation: fadeInUp 0.4s ease-out forwards;
    }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .station-distance-bar {
      transition: width 0.6s ease-out;
    }
  </style>
</head>
<body class="text-neutral-100 antialiased selection:bg-neutral-600">

  <div class="phone-container">
    <!-- Top Status Bar -->
    <header class="pt-3 px-5 pb-2 flex justify-between items-center text-xs text-neutral-400 border-b border-neutral-800/80 bg-neutral-900/60 backdrop-blur sticky top-0 z-50">
      <span id="liveClock" class="font-bold text-neutral-200 text-sm">--:-- MYT</span>
      <div class="flex items-center gap-2">
        <span class="px-1.5 py-0.5 rounded bg-purple-500/15 border border-purple-400/25 text-purple-200 text-[10px] font-mono font-semibold">LRT Kelana Jaya Line</span>
        <i class="fa-solid fa-wifi text-[11px]"></i>
        <i class="fa-solid fa-battery-full text-[12px]"></i>
      </div>
    </header>

    <!-- TAB 1: SEARCH SCREEN -->
    <main id="tab-search" class="screen flex-1 p-5 pb-24 overflow-y-auto">
      <div class="flex items-center gap-2 mb-4">
        <div class="w-8 h-8 rounded-lg bg-purple-700/70 border border-purple-400/30 flex items-center justify-center text-purple-50 shadow-lg shadow-purple-900/40">
          <i class="fa-solid fa-train text-sm"></i>
        </div>
        <div>
          <h1 class="text-lg font-bold tracking-tight text-white">LRT Route Planner</h1>
          <p class="text-xs text-neutral-400">Where are you going today?</p>
        </div>
      </div>

      <div class="bg-neutral-800/70 border border-neutral-700/60 rounded-2xl p-4 shadow-xl mb-5 backdrop-blur">
        <div class="space-y-3">
          <div class="relative">
            <label class="block text-[11px] font-semibold text-neutral-400 uppercase tracking-wider mb-1">From (Origin)</label>
            <div class="flex items-center bg-neutral-900/90 border border-neutral-700 rounded-xl px-3 py-2.5">
              <i class="fa-solid fa-location-dot text-neutral-400 text-sm mr-2.5"></i>
              <select id="selectOrigin" class="w-full bg-transparent text-sm text-white focus:outline-none cursor-pointer">
                <option value="SS15" class="bg-neutral-800">SS15 (KJ29)</option>
                <option value="Subang Jaya" class="bg-neutral-800">Subang Jaya (KJ28)</option>
                <option value="Kelana Jaya" class="bg-neutral-800">Kelana Jaya (KJ24)</option>
                <option value="Asia Jaya" class="bg-neutral-800">Asia Jaya (KJ21)</option>
                <option value="Universiti" class="bg-neutral-800">Universiti (KJ19)</option>
                <option value="KL Sentral" class="bg-neutral-800">KL Sentral (KJ15)</option>
              </select>
            </div>
          </div>

          <div class="relative">
            <label class="block text-[11px] font-semibold text-neutral-400 uppercase tracking-wider mb-1">To (Destination)</label>
            <div class="flex items-center bg-neutral-900/90 border border-neutral-700 rounded-xl px-3 py-2.5">
              <i class="fa-solid fa-flag-checkered text-neutral-400 text-sm mr-2.5"></i>
              <select id="selectDest" class="w-full bg-transparent text-sm text-white focus:outline-none cursor-pointer">
                <option value="KL Sentral" class="bg-neutral-800" selected>KL Sentral (KJ15)</option>
                <option value="Universiti" class="bg-neutral-800">Universiti (KJ19)</option>
                <option value="Asia Jaya" class="bg-neutral-800">Asia Jaya (KJ21)</option>
                <option value="Kelana Jaya" class="bg-neutral-800">Kelana Jaya (KJ24)</option>
                <option value="Subang Jaya" class="bg-neutral-800">Subang Jaya (KJ28)</option>
                <option value="SS15" class="bg-neutral-800">SS15 (KJ29)</option>
              </select>
            </div>
          </div>
        </div>

        <button id="btnSearch" onclick="calculateRoute()" class="w-full mt-4 bg-gradient-to-r from-neutral-600 to-neutral-600 hover:from-neutral-500 hover:to-neutral-500 text-white font-bold py-3 px-4 rounded-xl shadow-lg shadow-neutral-600/30 active:scale-[0.98] transition flex items-center justify-center gap-2">
          <i class="fa-solid fa-magnifying-glass"></i>
          <span>FIND ROUTE & ETA</span>
        </button>
      </div>

      <div id="routeResultCard" class="bg-neutral-800/40 border border-neutral-500/30 rounded-2xl p-4 mb-5">
        <div class="flex justify-between items-start pb-3 border-b border-neutral-700/60">
          <div>
            <span class="text-[10px] uppercase font-bold text-neutral-400 tracking-wider">Fastest Direct Path</span>
            <div class="text-base font-bold text-white flex items-center gap-2 mt-0.5">
              <span id="resOriginText">SS15</span>
              <i class="fa-solid fa-arrow-right text-xs text-neutral-400"></i>
              <span id="resDestText">KL Sentral</span>
            </div>
          </div>
          <div class="text-right">
            <span class="text-[10px] uppercase text-neutral-400 font-bold block">Est. Duration</span>
            <span id="resDuration" class="text-base font-bold text-neutral-400">28 mins</span>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-2 text-center pt-3 text-xs">
          <div class="bg-neutral-900/60 rounded-lg p-2 border border-neutral-700/40">
            <div class="text-[10px] text-neutral-400">Stops</div>
            <div id="resStops" class="font-bold text-neutral-200 mt-0.5">7 stations</div>
          </div>
          <div class="bg-neutral-900/60 rounded-lg p-2 border border-neutral-700/40">
            <div class="text-[10px] text-neutral-400">Distance</div>
            <div id="resDistance" class="font-bold text-neutral-200 mt-0.5">14.2 km</div>
          </div>
          <div class="bg-neutral-900/60 rounded-lg p-2 border border-neutral-700/40">
            <div class="text-[10px] text-neutral-400">Interchange</div>
            <div class="font-bold text-neutral-200 mt-0.5">Direct Line</div>
          </div>
        </div>
      </div>

      <div>
        <div class="flex justify-between items-center mb-3">
          <h2 class="text-sm font-bold text-white uppercase tracking-wider">Next Trains</h2>
          <span id="serviceStatusBadge" class="text-[11px] text-neutral-400 flex items-center gap-1 font-semibold" title="Service status source">
            <span class="w-2 h-2 rounded-full bg-green-500 pulse-dot"></span> Live Telemetry · MYT
          </span>
        </div>
        <div id="trainList" class="space-y-2.5"></div>
      </div>
    </main>

    <!-- TAB 2: LIVE MAP SCREEN — GPS Station Finder & Live Tracker -->
    <main id="tab-map" class="screen hidden flex-1 p-5 pb-24 overflow-y-auto">
      <div class="flex justify-between items-center mb-4">
        <div>
          <h1 class="text-lg font-bold text-white">Live Train Map</h1>
          <p class="text-xs text-neutral-400">GPS Station Finder & Live Tracker · <span id="mapLiveTime" class="text-purple-200 font-semibold">--:-- MYT</span></p>
        </div>
      </div>

      <!-- NEAREST STATION — GPS LOCATION CARD -->
      <div id="locationCard" class="location-card bg-gradient-to-br from-blue-950/30 to-neutral-900/80 border border-blue-500/25 rounded-2xl p-4 mb-4 shadow-lg shadow-blue-950/10">
        <div id="locStateIdle">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-blue-500/15 border border-blue-500/25 text-blue-400 flex items-center justify-center shrink-0">
              <i class="fa-solid fa-location-crosshairs text-lg"></i>
            </div>
            <div class="flex-1">
              <span class="text-[10px] font-bold uppercase tracking-wider text-blue-400">Find Nearest Station</span>
              <p class="text-xs text-neutral-300 mt-0.5">Allow location access to find the closest LRT station to you</p>
            </div>
          </div>
          <button onclick="requestUserLocation()" class="shimmer-btn w-full mt-3 bg-gradient-to-r from-blue-600/80 to-blue-700/80 hover:from-blue-500/90 hover:to-blue-600/90 text-white font-bold py-2.5 px-4 rounded-xl shadow-lg shadow-blue-900/30 active:scale-[0.98] transition flex items-center justify-center gap-2 text-sm">
            <i class="fa-solid fa-location-arrow"></i>
            <span>Use My Location</span>
          </button>
        </div>

        <div id="locStateLoading" class="hidden">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-blue-500/15 border border-blue-500/25 text-blue-400 flex items-center justify-center shrink-0">
              <i class="fa-solid fa-spinner fa-spin text-lg"></i>
            </div>
            <div>
              <span class="text-sm font-bold text-white">Acquiring GPS Signal…</span>
              <p class="text-xs text-neutral-400 mt-0.5">Requesting location from your device</p>
            </div>
          </div>
        </div>

        <div id="locStateSuccess" class="hidden fade-in-up">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
              <div class="relative">
                <div class="w-8 h-8 rounded-full bg-blue-500/20 border border-blue-400/40 flex items-center justify-center text-blue-400 location-breathe">
                  <i class="fa-solid fa-location-dot text-sm"></i>
                </div>
                <div class="absolute inset-0 rounded-full border border-blue-400/30 location-ping"></div>
              </div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-blue-400">Your Location · Live GPS</span>
            </div>
            <button onclick="requestUserLocation()" class="text-[10px] text-blue-400 hover:text-blue-300 font-semibold flex items-center gap-1 transition" title="Refresh location">
              <i class="fa-solid fa-rotate"></i> Refresh
            </button>
          </div>

          <div class="bg-neutral-900/70 border border-neutral-700/50 rounded-xl p-3 mb-3">
            <div class="flex items-center justify-between">
              <div>
                <span class="text-[10px] text-neutral-400 uppercase font-bold">Nearest Station</span>
                <div class="flex items-center gap-2 mt-0.5">
                  <span id="nearestStationName" class="text-base font-bold text-white">—</span>
                  <span id="nearestStationCode" class="text-[10px] px-1.5 py-0.5 rounded bg-blue-500/15 border border-blue-500/30 text-blue-300 font-mono font-semibold">—</span>
                </div>
              </div>
              <div class="text-right">
                <span class="text-[10px] text-neutral-400 uppercase font-bold">Distance</span>
                <div id="nearestStationDist" class="text-base font-bold text-blue-400 mt-0.5">— km</div>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-2 text-center text-xs mb-3">
            <div class="bg-neutral-900/60 rounded-lg p-2 border border-neutral-700/40">
              <div class="text-[10px] text-neutral-400"><i class="fa-solid fa-person-walking mr-1"></i>Walk</div>
              <div id="nearestWalkTime" class="font-bold text-neutral-200 mt-0.5">— min</div>
            </div>
            <div class="bg-neutral-900/60 rounded-lg p-2 border border-neutral-700/40">
              <div class="text-[10px] text-neutral-400"><i class="fa-solid fa-satellite-dish mr-1"></i>Accuracy</div>
              <div id="gpsAccuracy" class="font-bold text-neutral-200 mt-0.5">—</div>
            </div>
            <div class="bg-neutral-900/60 rounded-lg p-2 border border-neutral-700/40">
              <div class="text-[10px] text-neutral-400"><i class="fa-solid fa-compass mr-1"></i>Coords</div>
              <div id="gpsCoords" class="font-bold text-neutral-200 mt-0.5 text-[9px]">—</div>
            </div>
          </div>

          <div>
            <div class="text-[10px] font-bold text-neutral-400 uppercase tracking-wider mb-2">All Stations by Distance</div>
            <div id="stationDistanceList" class="space-y-1.5"></div>
          </div>

          <button id="btnSetOrigin" onclick="setNearestAsOrigin()" class="w-full mt-3 bg-gradient-to-r from-neutral-700 to-neutral-700 hover:from-neutral-600 hover:to-neutral-600 text-white font-bold py-2.5 px-4 rounded-xl shadow-lg active:scale-[0.98] transition flex items-center justify-center gap-2 text-xs">
            <i class="fa-solid fa-location-dot"></i>
            <span>Set Nearest as Departure Station</span>
          </button>
        </div>

        <div id="locStateError" class="hidden fade-in-up">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-xl bg-red-500/15 border border-red-500/25 text-red-400 flex items-center justify-center shrink-0">
              <i class="fa-solid fa-location-pin-lock text-lg"></i>
            </div>
            <div class="flex-1">
              <span class="text-[10px] font-bold uppercase tracking-wider text-red-400">Location Unavailable</span>
              <p id="locErrorMsg" class="text-xs text-neutral-300 mt-0.5">Unable to access your location.</p>
            </div>
          </div>
          <button onclick="requestUserLocation()" class="w-full mt-3 bg-neutral-700/50 hover:bg-neutral-600/60 text-white font-semibold py-2 px-4 rounded-xl transition flex items-center justify-center gap-2 text-xs border border-neutral-600/40">
            <i class="fa-solid fa-rotate"></i>
            <span>Try Again</span>
          </button>
        </div>
      </div>

      <!-- Train HUD Card — dynamic -->
      <div class="bg-gradient-to-br from-neutral-950/80 to-neutral-900 border border-neutral-500/40 rounded-2xl p-4 mb-4 shadow-lg">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-full bg-neutral-600 flex items-center justify-center text-white text-xs">
              <i class="fa-solid fa-train-subway"></i>
            </div>
            <div>
              <span id="hudTrainId" class="text-[11px] text-neutral-400 block font-mono">Next Train</span>
              <span id="hudTrainRoute" class="text-sm font-bold text-white">Kelana Jaya Bound</span>
            </div>
          </div>
          <span id="hudTrainStatus" class="px-2 py-0.5 rounded-full bg-neutral-500/20 border border-neutral-500/40 text-neutral-400 text-[10px] font-bold">
            ON TRACK
          </span>
        </div>
        <div class="mt-3 pt-3 border-t border-neutral-800 grid grid-cols-2 gap-2 text-xs">
          <div>
            <span class="text-neutral-400 text-[10px] block">Your Station:</span>
            <span id="hudCurrentStation" class="font-bold text-neutral-400 text-sm">SS15</span>
          </div>
          <div class="text-right">
            <span class="text-neutral-400 text-[10px] block">Next Train Arrives:</span>
            <span id="hudNextStation" class="font-bold text-neutral-400 text-sm">—</span>
          </div>
        </div>
      </div>

      <!-- Station Progression Tracker -->
      <div class="bg-neutral-800/40 border border-neutral-700/60 rounded-2xl p-4">
        <div class="text-xs font-bold text-neutral-300 mb-3 uppercase tracking-wider">Line Progression · Live ETA</div>
        <div class="train-track space-y-4 text-xs" id="stationTrackContainer"></div>
      </div>
    </main>

    <!-- TAB 3: ALERTS SCREEN -->
    <main id="tab-alerts" class="screen hidden flex-1 p-5 pb-24 overflow-y-auto">
      <div class="flex justify-between items-center mb-4">
        <div>
          <h1 class="text-lg font-bold text-white">Transit Alerts</h1>
          <p class="text-xs text-neutral-400">Push Notifications & Disruption Logs</p>
        </div>
        <span class="px-2 py-0.5 bg-red-500/15 border border-red-500/35 text-red-300 text-[10px] rounded-full font-bold">
          1 Active Alert
        </span>
      </div>

      <!-- Arrival Banner — synced with live train + GPS data -->
      <div id="arrivalAlertCard" class="bg-green-950/20 border border-green-500/35 rounded-2xl p-4 mb-3 shadow-lg shadow-green-950/10">
        <div class="flex items-start gap-3">
          <div class="w-9 h-9 rounded-xl bg-green-500/15 text-green-400 flex items-center justify-center shrink-0 text-base">
            <i class="fa-solid fa-bell"></i>
          </div>
          <div class="flex-1">
            <div class="flex items-center justify-between">
              <span id="arrivalAlertStatus" class="text-[10px] font-bold uppercase tracking-wider text-green-400">ARRIVING SOON · ON TIME</span>
              <span id="arrivalAlertTime" class="text-[10px] text-neutral-400">—</span>
            </div>
            <p id="arrivalAlertMsg" class="text-sm font-bold text-white mt-0.5">Waiting for train data…</p>
            <p id="arrivalAlertDetail" class="text-xs text-neutral-300 mt-0.5">Platform 1 &bull; Nearest Station</p>
          </div>
        </div>
      </div>

      <!-- Disruption Delay Alert -->
      <div class="bg-red-950/20 border border-red-500/40 rounded-2xl p-4 mb-4 shadow-lg shadow-red-950/10">
        <div class="flex items-start gap-3">
          <div class="w-9 h-9 rounded-xl bg-red-500/15 text-red-400 flex items-center justify-center shrink-0 text-base">
            <i class="fa-solid fa-triangle-exclamation"></i>
          </div>
          <div class="flex-1">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-bold uppercase tracking-wider text-red-400">DELAY ALERT · ACTION NEEDED</span>
              <span class="text-[10px] text-neutral-400">Updated 2m ago</span>
            </div>
            <p class="text-sm font-bold text-white mt-0.5">Train delayed by 10 minutes</p>
            <p class="text-xs text-neutral-300 mt-0.5">Signal maintenance near Universiti station. Technicians deployed.</p>
          </div>
        </div>
      </div>

      <div class="bg-neutral-800/40 border border-neutral-700/60 rounded-2xl p-4">
        <h3 class="text-xs font-bold text-white uppercase tracking-wider mb-3">Notification Preferences</h3>
        <div class="space-y-3 text-xs">
          <label class="flex items-center justify-between p-2 rounded-lg bg-neutral-900/60 border border-neutral-700/40 cursor-pointer">
            <span>Arrival Notifications (3 min warning)</span>
            <input type="checkbox" checked class="w-4 h-4 accent-neutral-600 rounded" />
          </label>
          <label class="flex items-center justify-between p-2 rounded-lg bg-neutral-900/60 border border-neutral-700/40 cursor-pointer">
            <span>Delays & Platform Change Alerts</span>
            <input type="checkbox" checked class="w-4 h-4 accent-neutral-600 rounded" />
          </label>
          <label class="flex items-center justify-between p-2 rounded-lg bg-neutral-900/60 border border-neutral-700/40 cursor-pointer">
            <span>Offline Schedule Cache Sync</span>
            <input type="checkbox" checked class="w-4 h-4 accent-neutral-600 rounded" />
          </label>
        </div>
      </div>
    </main>

    <!-- Bottom Navigation Bar -->
    <nav class="fixed bottom-0 left-0 right-0 max-w-[420px] mx-auto bg-neutral-900/90 backdrop-blur border-t border-neutral-800 p-2 flex justify-around items-center z-50">
      <button onclick="switchTab('search')" id="nav-search" class="nav-btn flex flex-col items-center gap-1 text-neutral-400 px-4 py-1.5 transition">
        <i class="fa-solid fa-house text-base"></i>
        <span class="text-[10px] font-semibold">Search</span>
      </button>
      <button onclick="switchTab('map')" id="nav-map" class="nav-btn flex flex-col items-center gap-1 text-neutral-400 hover:text-neutral-200 px-4 py-1.5 transition">
        <i class="fa-solid fa-map-location-dot text-base"></i>
        <span class="text-[10px] font-semibold">Live Map</span>
      </button>
      <button onclick="switchTab('alerts')" id="nav-alerts" class="nav-btn flex flex-col items-center gap-1 text-neutral-400 hover:text-neutral-200 px-4 py-1.5 relative transition">
        <div class="relative">
          <i class="fa-solid fa-bell text-base"></i>
          <span class="absolute -top-1 -right-1 w-2 h-2 bg-neutral-500 rounded-full"></span>
        </div>
        <span class="text-[10px] font-semibold">Alerts</span>
      </button>
    </nav>
  </div>

  <script>
    // ══════════════════════════════════════════════════════════
    // System Data — stations include GPS coordinates
    // ══════════════════════════════════════════════════════════
    const railwaySystem = {
      stations: [
        { id: 1, name: "SS15",         code: "KJ29", distanceKm: 0,    lat: 3.0778, lng: 101.5872 },
        { id: 2, name: "Subang Jaya",  code: "KJ28", distanceKm: 2.1,  lat: 3.0843, lng: 101.5866 },
        { id: 3, name: "Glenmarie",    code: "KJ27", distanceKm: 4.8,  lat: 3.0905, lng: 101.5938 },
        { id: 4, name: "Kelana Jaya",  code: "KJ24", distanceKm: 8.2,  lat: 3.1064, lng: 101.6046 },
        { id: 5, name: "Asia Jaya",    code: "KJ21", distanceKm: 11.5, lat: 3.1087, lng: 101.6458 },
        { id: 6, name: "Universiti",   code: "KJ19", distanceKm: 13.1, lat: 3.1167, lng: 101.6552 },
        { id: 7, name: "KL Sentral",   code: "KJ15", distanceKm: 18.0, lat: 3.1343, lng: 101.6863 }
      ],
      trains: [],
      lrtSchedule: { firstService: 5 * 60 + 30, lastService: 23 * 60 + 30, frequency: 15 },
      timezone: "Asia/Kuala_Lumpur",
      serviceStatus: null,
      serviceStatusSource: 'schedule',
      currentTrainIndex: 0,
      userLocation: null,
      nearestStation: null,
      geoWatchId: null
    };
    // ══════════════════════════════════════════════════════════
    // GEOLOCATION — Nearest Station Finder
    // ══════════════════════════════════════════════════════════

    function haversineDistance(lat1, lng1, lat2, lng2) {
      const R = 6371;
      const toRad = deg => deg * (Math.PI / 180);
      const dLat = toRad(lat2 - lat1);
      const dLng = toRad(lng2 - lng1);
      const a = Math.sin(dLat / 2) ** 2 +
                Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) *
                Math.sin(dLng / 2) ** 2;
      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    function findNearestStation(lat, lng) {
      return railwaySystem.stations
        .map(st => ({ ...st, userDistKm: haversineDistance(lat, lng, st.lat, st.lng) }))
        .sort((a, b) => a.userDistKm - b.userDistKm);
    }

    function setLocationState(state) {
      ['Idle', 'Loading', 'Success', 'Error'].forEach(s => {
        document.getElementById(`locState${s}`).classList.toggle('hidden', s.toLowerCase() !== state);
      });
    }

    function walkingMinutes(distKm) {
      return Math.max(1, Math.round(distKm / 5 * 60));
    }

    function updateLocationUI(position) {
      const { latitude: lat, longitude: lng, accuracy } = position.coords;
      railwaySystem.userLocation = { lat, lng, accuracy };

      const ranked = findNearestStation(lat, lng);
      const nearest = ranked[0];
      railwaySystem.nearestStation = nearest;

      document.getElementById('nearestStationName').textContent = nearest.name;
      document.getElementById('nearestStationCode').textContent = nearest.code;
      document.getElementById('nearestStationDist').textContent =
        nearest.userDistKm < 1
          ? `${Math.round(nearest.userDistKm * 1000)} m`
          : `${nearest.userDistKm.toFixed(2)} km`;
      document.getElementById('nearestWalkTime').textContent = `${walkingMinutes(nearest.userDistKm)} min`;
      document.getElementById('gpsAccuracy').textContent =
        accuracy < 50 ? `±${Math.round(accuracy)}m` : `±${(accuracy / 1000).toFixed(1)}km`;
      document.getElementById('gpsCoords').textContent =
        `${lat.toFixed(4)}, ${lng.toFixed(4)}`;

      const maxDist = ranked[ranked.length - 1].userDistKm || 1;
      const listContainer = document.getElementById('stationDistanceList');
      listContainer.innerHTML = ranked.map((st, i) => {
        const pct = Math.max(5, (st.userDistKm / maxDist) * 100);
        const isNearest = i === 0;
        const distLabel = st.userDistKm < 1
          ? `${Math.round(st.userDistKm * 1000)} m`
          : `${st.userDistKm.toFixed(2)} km`;
        return `
          <div class="flex items-center gap-2 ${isNearest ? 'bg-blue-950/30 border border-blue-500/20' : 'bg-neutral-900/40 border border-neutral-800/60'} rounded-lg p-2 transition">
            <div class="w-6 text-center">
              ${isNearest
                ? '<i class="fa-solid fa-location-dot text-blue-400 text-xs"></i>'
                : `<span class="text-[10px] text-neutral-500 font-mono">${i + 1}</span>`
              }
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between mb-1">
                <span class="text-xs font-semibold ${isNearest ? 'text-blue-300' : 'text-neutral-300'} truncate">${st.name}</span>
                <span class="text-[10px] ${isNearest ? 'text-blue-400 font-bold' : 'text-neutral-400'} ml-2 shrink-0">${distLabel}</span>
              </div>
              <div class="w-full bg-neutral-800 rounded-full h-1">
                <div class="station-distance-bar h-1 rounded-full ${isNearest ? 'bg-blue-500' : 'bg-neutral-600'}" style="width: ${pct}%"></div>
              </div>
            </div>
            <span class="text-[9px] text-neutral-500 font-mono shrink-0 w-8 text-right">${st.code}</span>
          </div>
        `;
      }).join('');

      setLocationState('success');

      // Re-render station track and alerts with new location
      renderStationTrack();
      updateArrivalAlert();
    }

    function handleLocationError(error) {
      const messages = {
        1: 'Location permission denied. Please enable location access in your browser or phone settings and try again.',
        2: 'Unable to determine your location. Make sure GPS is enabled on your device.',
        3: 'Location request timed out. Please check your connection and try again.'
      };
      document.getElementById('locErrorMsg').textContent =
        messages[error.code] || 'An unknown error occurred while accessing your location.';
      setLocationState('error');
      console.warn('[RailGo] Geolocation error:', error.message);
    }

    function requestUserLocation() {
      if (!navigator.geolocation) {
        document.getElementById('locErrorMsg').textContent =
          'Geolocation is not supported by this browser. Try using a modern mobile browser.';
        setLocationState('error');
        return;
      }

      setLocationState('loading');

      const geoOptions = { enableHighAccuracy: true, timeout: 15000, maximumAge: 30000 };

      navigator.geolocation.getCurrentPosition(updateLocationUI, handleLocationError, geoOptions);

      if (railwaySystem.geoWatchId !== null) {
        navigator.geolocation.clearWatch(railwaySystem.geoWatchId);
      }
      railwaySystem.geoWatchId = navigator.geolocation.watchPosition(
        updateLocationUI,
        (err) => console.warn('[RailGo] Watch position error:', err.message),
        { enableHighAccuracy: true, maximumAge: 60000 }
      );
    }

    function setNearestAsOrigin() {
      if (!railwaySystem.nearestStation) return;
      const selectOrigin = document.getElementById('selectOrigin');
      const stationName = railwaySystem.nearestStation.name;
      const optionExists = Array.from(selectOrigin.options).some(opt => opt.value === stationName);
      if (optionExists) selectOrigin.value = stationName;

      const card = document.getElementById('locationCard');
      card.classList.add('ring-2', 'ring-blue-500/60');
      setTimeout(() => card.classList.remove('ring-2', 'ring-blue-500/60'), 800);

      switchTab('search');
      calculateRoute();
    }

    // ══════════════════════════════════════════════════════════
    // TAB SWITCHER — auto-request location on Live Map tab
    // ══════════════════════════════════════════════════════════

    function switchTab(tabName) {
      document.querySelectorAll('.screen').forEach(s => s.classList.add('hidden'));
      document.querySelectorAll('.nav-btn').forEach(btn => {
        btn.classList.remove('text-neutral-400');
        btn.classList.add('text-neutral-400');
      });

      document.getElementById(`tab-${tabName}`).classList.remove('hidden');
      document.getElementById(`nav-${tabName}`).classList.remove('text-neutral-400');
      document.getElementById(`nav-${tabName}`).classList.add('text-neutral-400');

      if (tabName === 'map' && !railwaySystem.userLocation) {
        setTimeout(() => requestUserLocation(), 400);
      }
    }

    function getMalaysiaNow() {
      const parts = new Intl.DateTimeFormat('en-GB', {
        timeZone: railwaySystem.timezone,
        hour: '2-digit', minute: '2-digit', hour12: false
      }).formatToParts(new Date());
      const hour = Number(parts.find(part => part.type === 'hour').value);
      const minute = Number(parts.find(part => part.type === 'minute').value);
      return { hour, minute, totalMinutes: hour * 60 + minute };
    }

    function formatScheduleTime(totalMinutes) {
      const hour24 = Math.floor(totalMinutes / 60) % 24;
      const minute = totalMinutes % 60;
      const period = hour24 >= 12 ? 'PM' : 'AM';
      const hour12 = hour24 % 12 || 12;
      return `${hour12}:${String(minute).padStart(2, '0')} ${period}`;
    }

    const SERVICE_STATUS_API = 'https://api.mtrec.name.my/api/servicestatus';

    function statusText(value) {
      return typeof value === 'string' ? value.toLowerCase() : '';
    }

    function findStatusText(value) {
      if (typeof value === 'string') return value;
      if (Array.isArray(value)) return value.map(findStatusText).join(' ');
      if (value && typeof value === 'object') return Object.values(value).map(findStatusText).join(' ');
      return '';
    }

    async function fetchServiceStatus() {
      try {
        const response = await fetch(SERVICE_STATUS_API, { headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error(`Status API returned ${response.status}`);
        railwaySystem.serviceStatus = await response.json();
        railwaySystem.serviceStatusSource = 'api';
      } catch (error) {
        console.warn('[v0] Service status API unavailable; using timetable fallback.', error);
        railwaySystem.serviceStatus = null;
        railwaySystem.serviceStatusSource = 'schedule';
      }
      updateServiceStatusBadge();
    }

    function updateServiceStatusBadge() {
      const badge = document.getElementById('serviceStatusBadge');
      if (!badge) return;
      const isApi = railwaySystem.serviceStatusSource === 'api';
      badge.innerHTML = `<span class="w-2 h-2 rounded-full ${isApi ? 'bg-green-500' : 'bg-yellow-500'} pulse-dot"></span> ${isApi ? 'Live API · MYT' : 'Timetable · MYT'}`;
      badge.title = isApi ? 'Live service status from api.mtrec.name.my' : 'Live API unavailable; showing scheduled LRT times';
    }

    function getLiveStatus(index) {
      const text = statusText(findStatusText(railwaySystem.serviceStatus));
      if (!text) return index === 2 ? { label: 'Delayed 10m', color: 'red', delay: 10 } : { label: 'On Time', color: 'green', delay: 0 };
      const delayed = /delay|disrupt|suspend|停|gangguan|lambat/.test(text);
      return delayed ? { label: 'Service Alert', color: 'red', delay: 0 } : { label: 'On Time', color: 'green', delay: 0 };
    }

    function refreshTrainSchedule() {
      const now = getMalaysiaNow();
      const { firstService, lastService, frequency } = railwaySystem.lrtSchedule;
      const beforeFirstTrain = now.totalMinutes < firstService;
      const afterLastTrain = now.totalMinutes > lastService;
      const nextServiceOffset = afterLastTrain ? 24 * 60 : 0;
      let nextDeparture = beforeFirstTrain
        ? firstService
        : afterLastTrain
          ? firstService + nextServiceOffset
          : firstService + Math.ceil((now.totalMinutes - firstService) / frequency) * frequency;
      const departures = Array.from({ length: 3 }, (_, index) => nextDeparture + index * frequency);
      railwaySystem.trains = departures.map((departure, index) => {
        const departureOnNextDay = departure >= 24 * 60;
        const scheduleMinutes = departure % (24 * 60);
        const minutesUntilDeparture = departureOnNextDay
          ? departure - now.totalMinutes
          : Math.max(0, departure - now.totalMinutes);
        const liveStatus = getLiveStatus(index);
        const etaMin = minutesUntilDeparture + liveStatus.delay;
        return {
          id: `TR-${204 + index * 4}`,
          route: 'SS15 -> KL Sentral',
          departure: formatScheduleTime(scheduleMinutes),
          etaMin,
          status: liveStatus.label,
          statusColor: liveStatus.color,
          departureMinutes: scheduleMinutes,
          nextDay: departureOnNextDay
        };
      }).filter(train => train.nextDay || train.departureMinutes <= lastService)
        .map(({ departureMinutes, nextDay, ...train }) => train);

      renderTrains();
      renderStationTrack();
      updateArrivalAlert();
    }

    // Render Trains List in Search Tab
    function renderTrains() {
      const container = document.getElementById('trainList');
      container.innerHTML = railwaySystem.trains.map((t) => `
        <div class="flex items-center justify-between p-3 rounded-xl bg-neutral-800/80 border border-neutral-700/60 hover:border-neutral-600 transition">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-lg bg-neutral-600/20 text-neutral-400 flex items-center justify-center font-mono font-bold text-xs">
              <i class="fa-solid fa-train"></i>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="text-sm font-bold text-white">${t.departure}</span>
                <span class="text-[10px] px-1.5 py-0.5 rounded font-semibold ${t.statusColor === 'red' ? 'bg-red-500/15 text-red-400 border border-red-500/30' : 'bg-green-500/15 text-green-400 border border-green-500/30'}">
                  ${t.status}
                </span>
              </div>
              <span class="text-[11px] text-neutral-400 font-mono">${t.id} &bull; To KL Sentral</span>
            </div>
          </div>
          <div class="text-right">
            <span class="text-sm font-bold ${t.statusColor === 'red' ? 'text-red-400' : 'text-green-400'}">${t.etaMin} min</span>
            <span class="block text-[10px] text-neutral-400">Wait ETA · MYT</span>
          </div>
        </div>
      `).join('');
    }

    // Dynamic Route Calculation
    function calculateRoute() {
      const orig = document.getElementById('selectOrigin').value;
      const dest = document.getElementById('selectDest').value;

      if (orig === dest) {
        alert("Origin and destination cannot be identical.");
        return;
      }

      document.getElementById('resOriginText').innerText = orig;
      document.getElementById('resDestText').innerText = dest;
      
      const st1 = railwaySystem.stations.find(s => s.name === orig) || { distanceKm: 0 };
      const st2 = railwaySystem.stations.find(s => s.name === dest) || { distanceKm: 15 };
      const diffKm = Math.abs(st2.distanceKm - st1.distanceKm) || 12.4;
      const estMins = Math.round(diffKm * 1.8) + 4;
      const stops = Math.max(2, Math.round(diffKm / 2.2));

      document.getElementById('resDuration').innerText = `${estMins} mins`;
      document.getElementById('resStops').innerText = `${stops} stations`;
      document.getElementById('resDistance').innerText = `${diffKm.toFixed(1)} km`;

      const card = document.getElementById('routeResultCard');
      card.classList.add('ring-2', 'ring-neutral-500');
      setTimeout(() => card.classList.remove('ring-2', 'ring-neutral-500'), 600);
    }

    // ══════════════════════════════════════════════════════════
    // STATION TRACK — GPS-aware with real train ETAs
    // Uses nearest station from GPS + next train schedule data
    // to show when the train reaches each station in real time.
    // ══════════════════════════════════════════════════════════
    function renderStationTrack() {
      const container = document.getElementById('stationTrackContainer');
      const stations = railwaySystem.stations;

      // Determine user's nearest station from GPS (fallback to first station)
      let userIdx = 0;
      if (railwaySystem.nearestStation) {
        const foundIdx = stations.findIndex(s => s.id === railwaySystem.nearestStation.id);
        if (foundIdx >= 0) userIdx = foundIdx;
      }

      // Get next train timing
      const nextTrain = railwaySystem.trains[0];
      const baseEta = nextTrain ? nextTrain.etaMin : 5;
      const perStopMin = 3; // avg minutes between consecutive stations

      // Train departs station 0 (SS15) in baseEta minutes,
      // so it reaches station i in: baseEta + (i * perStopMin)
      const trainAtUserMin = baseEta + (userIdx * perStopMin);

      container.innerHTML = stations.map((st, i) => {
        const isUser = i === userIdx;
        const isBefore = i < userIdx;
        const trainAtStationMin = baseEta + (i * perStopMin);

        // Time label for each station
        let timeLabel = '';
        if (isUser) {
          timeLabel = `<span class="text-[10px] px-2 py-0.5 rounded bg-blue-500/20 text-blue-300 font-bold"><i class="fa-solid fa-location-dot mr-1"></i>YOU · Train in ${trainAtUserMin} min</span>`;
        } else if (isBefore) {
          timeLabel = `<span class="text-[10px] text-neutral-500">Train here in ${trainAtStationMin} min</span>`;
        } else {
          const minsAfterUser = trainAtStationMin - trainAtUserMin;
          timeLabel = `<span class="text-[10px] text-neutral-400 font-semibold">+${minsAfterUser} min after you</span>`;
        }

        return `
          <div class="flex items-center gap-3 relative z-10">
            <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-xs shrink-0 
              ${isUser ? 'bg-blue-600 text-white ring-4 ring-blue-500/30 shadow-lg shadow-blue-500/40 location-breathe' :
                isBefore ? 'bg-neutral-700 text-neutral-500' : 'bg-neutral-800 text-neutral-300 border border-neutral-600'}">
              ${isUser ? '<i class="fa-solid fa-location-dot"></i>' : (i + 1)}
            </div>
            <div class="flex-1 bg-neutral-900/60 border ${isUser ? 'border-blue-500/40 bg-blue-950/20' : isBefore ? 'border-neutral-800/60' : 'border-neutral-800'} rounded-xl p-2.5 flex justify-between items-center">
              <div>
                <div class="font-bold text-sm ${isUser ? 'text-blue-300' : isBefore ? 'text-neutral-500' : 'text-neutral-200'}">
                  ${st.name}
                </div>
                <div class="text-[10px] text-neutral-400 font-mono">${st.code} &bull; Platform 1</div>
              </div>
              <div class="text-right">
                ${timeLabel}
              </div>
            </div>
          </div>
        `;
      }).join('');

      // Update HUD card
      const userSt = stations[userIdx];
      document.getElementById('hudCurrentStation').innerText = userSt.name;

      if (nextTrain) {
        document.getElementById('hudTrainId').innerText = `Train ${nextTrain.id}`;
        document.getElementById('hudNextStation').innerText = `In ${trainAtUserMin} min`;
        document.getElementById('hudTrainStatus').innerText = nextTrain.status;
        document.getElementById('hudTrainStatus').className =
          `px-2 py-0.5 rounded-full text-[10px] font-bold ${
            nextTrain.statusColor === 'red'
              ? 'bg-red-500/20 border border-red-500/40 text-red-400'
              : 'bg-green-500/20 border border-green-500/40 text-green-400'
          }`;
      } else {
        document.getElementById('hudTrainId').innerText = 'No Train';
        document.getElementById('hudNextStation').innerText = 'Service ended';
      }
    }

    // ══════════════════════════════════════════════════════════
    // ALERTS SYNC — Arriving Soon card mirrors live train data
    // ══════════════════════════════════════════════════════════
    function updateArrivalAlert() {
      const nextTrain = railwaySystem.trains[0];
      const statusEl = document.getElementById('arrivalAlertStatus');
      const timeEl = document.getElementById('arrivalAlertTime');
      const msgEl = document.getElementById('arrivalAlertMsg');
      const detailEl = document.getElementById('arrivalAlertDetail');
      const cardEl = document.getElementById('arrivalAlertCard');

      if (!statusEl || !nextTrain) return;

      const stations = railwaySystem.stations;
      let userIdx = 0;
      if (railwaySystem.nearestStation) {
        const foundIdx = stations.findIndex(s => s.id === railwaySystem.nearestStation.id);
        if (foundIdx >= 0) userIdx = foundIdx;
      }

      const perStopMin = 3;
      const trainArrivalMin = nextTrain.etaMin + (userIdx * perStopMin);
      const userStation = stations[userIdx];

      // Card styling based on urgency
      if (trainArrivalMin <= 3) {
        statusEl.textContent = `ARRIVING NOW · ${nextTrain.status}`;
        cardEl.className = 'bg-green-950/30 border border-green-400/50 rounded-2xl p-4 mb-3 shadow-lg shadow-green-950/20';
        statusEl.className = 'text-[10px] font-bold uppercase tracking-wider text-green-400';
      } else if (trainArrivalMin <= 8) {
        statusEl.textContent = `ARRIVING SOON · ${nextTrain.status}`;
        cardEl.className = 'bg-green-950/20 border border-green-500/35 rounded-2xl p-4 mb-3 shadow-lg shadow-green-950/10';
        statusEl.className = 'text-[10px] font-bold uppercase tracking-wider text-green-400';
      } else {
        statusEl.textContent = `NEXT TRAIN · ${nextTrain.status}`;
        cardEl.className = 'bg-blue-950/20 border border-blue-500/30 rounded-2xl p-4 mb-3 shadow-lg shadow-blue-950/10';
        statusEl.className = 'text-[10px] font-bold uppercase tracking-wider text-blue-400';
      }

      timeEl.textContent = nextTrain.departure;
      msgEl.textContent = `Train ${nextTrain.id} arrives at ${userStation.name} in ${trainArrivalMin} min`;
      detailEl.innerHTML = `Platform 1 &bull; ${userStation.code} &bull; ${nextTrain.status}`;
    }

    // Real-Time Clock
    function updateClock() {
      const now = new Date();
      const time = new Intl.DateTimeFormat('en-MY', {
        timeZone: railwaySystem.timezone,
        hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false
      }).format(now);
      const formattedTime = `${time} MYT`;
      document.getElementById('liveClock').innerText = formattedTime;
      const mapLiveTime = document.getElementById('mapLiveTime');
      if (mapLiveTime) mapLiveTime.innerText = formattedTime;
    }

    // Initialize App
    window.addEventListener('DOMContentLoaded', () => {
      refreshTrainSchedule();
      fetchServiceStatus().then(refreshTrainSchedule);
      renderStationTrack();
      updateArrivalAlert();
      setInterval(updateClock, 1000);
      setInterval(() => fetchServiceStatus().then(refreshTrainSchedule), 30000);
      updateClock();
    });
  </script>
</body>
